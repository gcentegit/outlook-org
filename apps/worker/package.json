{
  "name": "@clasificador/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker del clasificador: migraciones, sincronización con el buzón y limpieza.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
