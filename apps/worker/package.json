    "test": "vitest run",
    "reprocess": "tsx --env-file-if-exists=../../.env scripts/reprocess.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@azure/identity": "^4.14.0",
    "@clasificador/db": "workspace:*",
    "@clasificador/shared": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.150",
    "html-to-text": "^10.0.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "tsx": "^4.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/pg": "^8.23.1",
    "vitest": "^4.1.12"
  }
