# Copia este fichero a .env (no se sube al repositorio) y ajusta los valores.
# Aquí no hay valores reales: las claves y secretos van solo en tu .env o en Dokploy.

# --- PostgreSQL local (compose.dev.yml publica el puerto POSTGRES_HOST_PORT en 127.0.0.1) ---
POSTGRES_USER=clasificador
# Cámbiala en cualquier entorno que no sea tu máquina.
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=clasificador
POSTGRES_HOST_PORT=5442

# --- Puertos del host en local ---
# 3110 por defecto (el 3100 lo usa otro proyecto). Si está ocupado, cámbialo aquí; no pares el otro proceso.
WEB_HOST_PORT=3110
DOCLING_HOST_PORT=5101

# --- Aplicación (worker y web) ---
# Conexión desde el host (pnpm dev, migraciones, semilla). Dentro de compose la fija el propio compose.
DATABASE_URL=postgresql://clasificador:cambia-esta-clave@localhost:5442/clasificador
# Versión mostrada en /health y /api/health; en las imágenes la fija el build (sha corto).
APP_VERSION=dev
# Worker: puerto interno de /health y /livez, segundos sin sincronizar para devolver 503 en /health
# (la frescura la vigila Uptime Kuma; el HEALTHCHECK de Docker usa /livez y no la mide) y URL de docling-serve.
HEALTH_PORT=8080
SYNC_STALE_SECONDS=300
DOCLING_URL=http://localhost:5101

# --- Servicio de sincronización (worker) ---
# shadow: registra decisiones sin tocar el buzón. live (aplicar categorías) aún no existe: el worker no arranca con live.
MODE=shadow
# Segundos entre sincronizaciones de la Bandeja de entrada (recomendado 60-120; admite 15-600).
POLL_INTERVAL_SECONDS=90
# Correos que se procesan a la vez (docling es el cuello de botella).
WORKER_CONCURRENCY=2
# Administrador inicial del panel: el worker lo da de alta al arrancar solo si no hay ningún usuario
# autorizado (nunca vuelve a darlo de alta si alguien lo quita). Sin valor no hay administrador por defecto:
# con la lista de usuarios vacía el worker lo avisa en el log, arranca igualmente y nadie podrá entrar al panel.
# ADMIN_EMAIL=admin@ejemplo.com
# Dominios de correo del grupo, separados por comas. Sus remitentes son internos: su pie de firma no cuenta
# como regla fuerte y no se proponen reglas con ellos. Sin valor no hay dominios internos.
# INTERNAL_EMAIL_DOMAINS=ejemplo.com,grupo.example
# URL de push de Uptime Kuma (heartbeat tras cada sincronización); sin ella no se envía nada.
# UPTIME_KUMA_PUSH_URL=https://kuma.example.com/api/push/TOKEN

# --- Extracción de correos (worker) ---
# Microsoft Graph con certificado: se rellenan cuando haya acceso al buzón (certificado aplazado).
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CERT_PATH=/run/secrets/graph-cert.pem
# Buzón que se clasifica (dirección completa). Sin valor, el worker no sincroniza y lo indica en /health.
# MAILBOX=buzon@ejemplo.com
# Adjuntos: tamaño máximo en bytes (15 MiB), páginas de PDF que se convierten y tiempo máximo de docling.
ATTACHMENT_MAX_BYTES=15728640
ATTACHMENT_MAX_PAGES=2
DOCLING_TIMEOUT_SECONDS=180

# --- Clasificador: claves de LLM (solo las de los proveedores que uses) y umbral de confianza ---
# El proveedor y el modelo activos se eligen en el panel (tabla LlmSetting); aquí solo van las claves.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Ollama local u otra API compatible con OpenAI (la clave es opcional en Ollama).
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=
CLASSIFY_CONFIDENCE_THRESHOLD=0.8

# --- Panel web (apps/web) ---
# Login con Microsoft: app "Clasificador Proveedores - Panel" de Entra ID (parte C de docs/guia-entra-id-rbac.md).
# Sin estas tres variables el panel arranca y avisa en /login de que falta configurarlas.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# Clave que cifra la cookie de sesión (obligatoria en producción): openssl rand -base64 32
# BETTER_AUTH_SECRET=
# URL pública del panel; debe coincidir con la URI de redirección de la app de Entra (/api/auth/callback/microsoft).
BETTER_AUTH_URL=http://localhost:3110
# Solo desarrollo: entra sin login como el primer usuario autorizado. Solo funciona con `next dev`
# (NODE_ENV=development); la compilación de producción lo ignora.
# AUTH_DEV_BYPASS=true
# El panel NO tiene credenciales de Graph: leer y crear las categorías del buzón se lo pide al worker
# (cola de trabajos), que es el único que lleva GRAPH_*, el certificado y MAILBOX.
